/*
 * Default parameters for the workflow.
 */
workflow.output.mode = 'copy'
params {
    msaDirs = ['results/MSA_outputs/test', 'results/MSA_outputs/test_gapless']
}

profiles {
    /*
     * Runs for testing
     */
    smallrun {
        params.msaDirs = ['results/MSA_outputs/smalldir']
    }
    /*
     * Runs for NCBI data sets
     */
    //By taxa
    ncbimammal {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/mammalFullHistoneH3only_94.00',
            'saved-results/ncbi original data/MSA_outputs/mammalGrowthHormone_30.50',
            'saved-results/ncbi original data/MSA_outputs/mammalMHConly_52.79',
        ]
    }
    ncbianimal {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/animalCytochrome_32.14',
            'saved-results/ncbi original data/MSA_outputs/animalHistoneH3_81.71',
        ]
    }
    ncbieuka {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/eukaP53_36.21',
            'saved-results/ncbi original data/MSA_outputs/eukaHistoneH4_55.86',
        ]
    }
    ncbibacteria {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/bacteriaRpoB_54.43',
            'saved-results/ncbi original data/MSA_outputs/bacteriaBetaLactamase_17.00',
        ]
    }
    //viruses have a different MSA set but that doesn't affect this.
    ncbivirus {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/virusInfluenzaHemagglutinin_47.09',
            'saved-results/ncbi original data/MSA_outputs/virusHIVenv_12.36',
            'saved-results/ncbi original data/MSA_outputs/virusRdRp_6.36',
        ]
    }

    //By PID
    ncbipid0to20 {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/virusHIVenv_12.36',
            'saved-results/ncbi original data/MSA_outputs/virusRdRp_6.36',
            'saved-results/ncbi original data/MSA_outputs/bacteriaBetaLactamase_17.00',
        ]
    }
    ncbipid20to40 {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/eukaP53_36.21',
            'saved-results/ncbi original data/MSA_outputs/mammalGrowthHormone_30.50',
            'saved-results/ncbi original data/MSA_outputs/animalCytochrome_32.14',
        ]
    }
    ncbipid40to60 {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/virusInfluenzaHemagglutinin_47.09',
            'saved-results/ncbi original data/MSA_outputs/bacteriaRpoB_54.43',
            'saved-results/ncbi original data/MSA_outputs/eukaHistoneH4_55.86',
            'saved-results/ncbi original data/MSA_outputs/mammalMHConly_52.79',
        ]
    }
    ncbipid80to100 {
        params.msaDirs = [
            'saved-results/ncbi original data/MSA_outputs/animalHistoneH3_81.71',
            'saved-results/ncbi original data/MSA_outputs/mammalFullHistoneH3only_94.00',
        ]
    }


    /*
     * Runs for blast data sets
     */
    //By PID
    pid39to50 {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/humancox1_PID40to60_39.31', 'saved-results/blast data/MSA_outputs/humancox1_PID50to70_45.92', 'saved-results/blast data/MSA_outputs/lampreycox1_PID40to60_40.00']
    }
    pid50to60 {
        params.msaDirs = [
            'saved-results/blast data/MSA_outputs/PID50-60/humancox1_PID60to80_57.15',
            'saved-results/blast data/MSA_outputs/PID50-60/lampreycox1_PID50to70_52.46',
            'saved-results/blast data/MSA_outputs/PID50-60/ricecox1_PID40to60_54.38',
        ]
    }
    pid60to70 {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/PID60-70/corglcox1_PID50to70_67.69', 'saved-results/blast data/MSA_outputs/PID60-70/corglcox1_PID60to80_67.62', 'saved-results/blast data/MSA_outputs/PID60-70/humancox1_PID70to90_61.15', 'saved-results/blast data/MSA_outputs/PID60-70/humancox1_PID80to100_63.69', 'saved-results/blast data/MSA_outputs/PID60-70/lampreycox1_PID60to80_60.23', 'saved-results/blast data/MSA_outputs/PID60-70/lampreycox1_PID70to90_65.92', 'saved-results/blast data/MSA_outputs/PID60-70/lampreycox1_PID80to100_68.15', 'saved-results/blast data/MSA_outputs/PID60-70/ricecox1_PID50to70_66.38', 'saved-results/blast data/MSA_outputs/PID60-70/ricecox1_PID60to80_67.92']
    }
    pid70to82 {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/PID70-82/corglcox1_PID70to90_73.77', 'saved-results/blast data/MSA_outputs/PID70-82/octopuscox1_PID60to80_76.15', 'saved-results/blast data/MSA_outputs/PID70-82/octopuscox1_PID70to90_80.00', 'saved-results/blast data/MSA_outputs/PID70-82/octopuscox1_PID80to100_81.92', 'saved-results/blast data/MSA_outputs/PID70-82/ricecox1_PID70to90_70.92', 'saved-results/blast data/MSA_outputs/PID70-82/ricecox1_PID80to100_76.77']
    }
    //by taxa
    human {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/human/humancox1_PID40to60_39.31', 'saved-results/blast data/MSA_outputs/human/humancox1_PID50to70_45.92', 'saved-results/blast data/MSA_outputs/human/humancox1_PID60to80_57.15', 'saved-results/blast data/MSA_outputs/human/humancox1_PID70to90_61.15', 'saved-results/blast data/MSA_outputs/human/humancox1_PID80to100_63.69']
    }
    lamprey {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID40to60_40.00', 'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID50to70_52.46', 'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID60to80_60.23', 'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID70to90_65.92', 'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID80to100_68.15']
    }
    octopus {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/octopus/octopuscox1_PID60to80_76.15', 'saved-results/blast data/MSA_outputs/octopus/octopuscox1_PID70to90_80.00', 'saved-results/blast data/MSA_outputs/octopus/octopuscox1_PID80to100_81.92']
    }
    rice {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/rice/ricecox1_PID50to70_54.38', 'saved-results/blast data/MSA_outputs/rice/ricecox1_PID60to80_67.92', 'saved-results/blast data/MSA_outputs/rice/ricecox1_PID70to90_70.92', 'saved-results/blast data/MSA_outputs/rice/ricecox1_PID80to100_76.77']
    }
    corgl {
        params.msaDirs = ['saved-results/blast data/MSA_outputs/corgl/corglcox1_PID50to70_67.69', 'saved-results/blast data/MSA_outputs/corgl/corglcox1_PID60to80_67.62', 'saved-results/blast data/MSA_outputs/corgl/corglcox1_PID70to90_73.77']
    }

    /*
     * Mega averaging with everyone!
     */
    everyone {
        params.msaDirs = [
            // corgl
            'saved-results/blast data/MSA_outputs/corgl/corglcox1_PID50to70_67.69',
            'saved-results/blast data/MSA_outputs/corgl/corglcox1_PID60to80_67.62',
            'saved-results/blast data/MSA_outputs/corgl/corglcox1_PID70to90_73.77',

            // human
            'saved-results/blast data/MSA_outputs/human/humancox1_PID40to60_39.31',
            'saved-results/blast data/MSA_outputs/human/humancox1_PID50to70_45.92',
            'saved-results/blast data/MSA_outputs/human/humancox1_PID60to80_57.15',
            'saved-results/blast data/MSA_outputs/human/humancox1_PID70to90_61.15',
            'saved-results/blast data/MSA_outputs/human/humancox1_PID80to100_63.69',

            // lamprey
            'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID40to60_40.00',
            'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID50to70_52.46',
            'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID60to80_60.23',
            'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID70to90_65.92',
            'saved-results/blast data/MSA_outputs/lamprey/lampreycox1_PID80to100_68.15',

            // octopus
            'saved-results/blast data/MSA_outputs/octopus/octopuscox1_PID60to80_76.15',
            'saved-results/blast data/MSA_outputs/octopus/octopuscox1_PID70to90_80.00',
            'saved-results/blast data/MSA_outputs/octopus/octopuscox1_PID80to100_81.92',

            // rice
            'saved-results/blast data/MSA_outputs/rice/ricecox1_PID40to60_54.38',
            'saved-results/blast data/MSA_outputs/rice/ricecox1_PID50to70_66.38',
            'saved-results/blast data/MSA_outputs/rice/ricecox1_PID60to80_67.92',
            'saved-results/blast data/MSA_outputs/rice/ricecox1_PID70to90_70.92',
            'saved-results/blast data/MSA_outputs/rice/ricecox1_PID80to100_76.77',

            //NCBI
            'saved-results/ncbi original data/MSA_outputs/animalCytochrome_32.14',
            'saved-results/ncbi original data/MSA_outputs/animalHistoneH3_81.71',
            'saved-results/ncbi original data/MSA_outputs/bacteriaBetaLactamase_17.00',
            'saved-results/ncbi original data/MSA_outputs/bacteriaRpoB_54.43',
            'saved-results/ncbi original data/MSA_outputs/eukaHistoneH4_55.86',
            'saved-results/ncbi original data/MSA_outputs/eukaP53_36.21',
            'saved-results/ncbi original data/MSA_outputs/mammalFullHistoneH3only_94.00',
            'saved-results/ncbi original data/MSA_outputs/mammalGrowthHormone_30.50',
            'saved-results/ncbi original data/MSA_outputs/mammalMHConly_52.79',
        ]
    }
}
