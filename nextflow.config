/*
 * Default parameters for the workflow.
 */
workflow.output.mode = 'copy'
params {
    inputs = ['testdata/test.fasta', 'testdata/test_gapless.fasta:testdata/test_reference.fasta']
    runs = [
        'mafft_auto:mafft:mafft --auto',
        'muscle:muscle:-align',
        'kalign:kalign:',
        't_coffee:t_coffee:',
        'probcons:probcons:',
        'clustalw:clustalw:',
        'clustalo:clustalo:',
        'amap:amap:',
        'prank:prank:',
        'fsa:fsa:',
        'muscle3.8:muscle3.8:',
        'famsa:famsa:',
        'bali-phy:bali-phy:--iterations=15',
    ]
}

profiles {
    /*
     * Runs for testing
     */
    smallrun {
        params.inputs = ['testdata/test_gapless.fasta:testdata/test_reference.fasta']
        params.runs = [
            'mafft_auto:mafft:mafft --auto',
            'muscle:muscle:-align',
            'clustalo:clustalo:',
            'prank:prank:',
        ]
    }
    smallrunfromdir{
        params.makeEnsemble = false
        params.inputs = ['results/MSA_outputs/test_gapless_60.25']
    }
    smallishrun {
        //params.inputs = ['testdata/paganExampleReads.fas']
        params.runs = [
            'mafft_auto:mafft:mafft --auto',
            'muscle:muscle:-align',
            'clustalo:clustalo:',
            'prank:prank:',
        ]
    }

    /*
     * Runs for NCBI data sets
     */
    mammals {
        params.inputs = [
            'data/50seqs/mammalFullHistoneH3onlyNcbi50seq.fasta',
            'data/50seqs/mammalGrowthHormoneNcbi50seq.fasta',
            'data/50seqs/mammalMHConlyNcbi50seq.fasta',
        ]
    }
    animals {
        params.inputs = [
            'data/50seqs/animalCytochromeNcbi_50seq.fasta',
            'data/50seqs/animalsHistoneH3_50seq.fasta',
        ]
    }
    eukaryotes {
        params.inputs = [
            'data/50seqs/eukaHistoneH4_50seq.fasta',
            'data/50seqs/eukaP53_50seq.fasta',
        ]
    }
    bacteria {
        params.inputs = ['data/50seqs/bacteriaRpoB_50seq.fasta', 'data/50seqs/bacteriaBetaLactamase_modified50seq.fasta']
    }
    viruses {
        params.inputs = ['data/50seqs/virusHIVenv_50seq.fasta', 'data/50seqs/virusInfluenzaHemagglutinin_50seq.fasta', 'data/50seqs/virusRdRp_50seq.fasta']
        params.runs = [
            //no t-coffee or bali-phy for viruses, as they break
            'mafft_auto:mafft:mafft --auto',
            'muscle:muscle:-align',
            'kalign:kalign:',
            'probcons:probcons:',
            'clustalw:clustalw:',
            'clustalo:clustalo:',
            'amap:amap:',
            'prank:prank:',
            'fsa:fsa:',
            'muscle3.8:muscle3.8:',
            'famsa:famsa:',
        ]
    }
    all50seqs {
        params.inputs = ['data/50seqs/mammalFullHistoneH3onlyNcbi50seq.fasta', 'data/50seqs/mammalGrowthHormoneNcbi50seq.fasta', 'data/50seqs/mammalMHConlyNcbi50seq.fasta', 'data/50seqs/animalCytochromeNcbi_50seq.fasta', 'data/50seqs/animalsHistoneH3_50seq.fasta', 'data/50seqs/modified_sequences.fasta', 'data/50seqs/bacteriaRpoB_50seq.fasta', 'data/50seqs/eukaHistoneH4_50seq.fasta', 'data/50seqs/virusHIVenv_50seq.fasta', 'data/50seqs/virusInfluenzaHemagglutinin_50seq.fasta', 'data/50seqs/virusRdRp_50seq.fasta']
    }

    /*
     * Runs for blast data sets
     */
    blasthuman {
        params.inputs = ['data/50seqsblast/human/']
    }
    blastlamprey {
        params.inputs = ['data/50seqsblast/lamprey/']
    }
    blastoctopus {
        params.inputs = ['data/50seqsblast/octopus/']
    }
    blastrice {
        params.inputs = ['data/50seqsblast/rice/']
    }
    blastcorgl {
        params.inputs = ['data/50seqsblast/corgl/']
    }
    blast2 {
        params.inputs = [
            'data/50seqsblast/lamprey/',
            'data/50seqsblast/human/',
        ]
    }

    /*
     * Runs for simulated data sets
     */
    alisim1 {
        params.inputs = ['data/alisim1/alignment.unaligned.fa:data/alisim1/alignment.fa']
    }

    /*
     * Runs for balibase data
     */
    balibase {
        params.inputs = [
            // 'data/balibase/BBA0001.fasta:data/balibase/BBA0001_aligned.fasta',
            // 'data/balibase/BBA0002.fasta:data/balibase/BBA0002_aligned.fasta',
            // 'data/balibase/BBA0003.fasta:data/balibase/BBA0003_aligned.fasta',
            // //'data/balibase/BBA0004.fasta:data/balibase/BBA0004_aligned.fasta',
            // 'data/balibase/BBA0005.fasta:data/balibase/BBA0005_aligned.fasta',
            // 'data/balibase/BBA0006.fasta:data/balibase/BBA0006_aligned.fasta',
            // 'data/balibase/BBA0007.fasta:data/balibase/BBA0007_aligned.fasta',
            // 'data/balibase/BBA0008.fasta:data/balibase/BBA0008_aligned.fasta',
            // 'data/balibase/BBA0009.fasta:data/balibase/BBA0009_aligned.fasta',
            // 'data/balibase/BBA0010.fasta:data/balibase/BBA0010_aligned.fasta',
            // 'data/balibase/BBA0011.fasta:data/balibase/BBA0011_aligned.fasta',
            // 'data/balibase/BBA0012.fasta:data/balibase/BBA0012_aligned.fasta',
            // 'data/balibase/BBA0013.fasta:data/balibase/BBA0013_aligned.fasta',
            // 'data/balibase/BBA0014.fasta:data/balibase/BBA0014_aligned.fasta',
            // 'data/balibase/BBA0015.fasta:data/balibase/BBA0015_aligned.fasta',
            // 'data/balibase/BBA0016.fasta:data/balibase/BBA0016_aligned.fasta',
            // 'data/balibase/BBA0017.fasta:data/balibase/BBA0017_aligned.fasta',
            // 'data/balibase/BBA0018.fasta:data/balibase/BBA0018_aligned.fasta',
            // 'data/balibase/BBA0019.fasta:data/balibase/BBA0019_aligned.fasta',
            // 'data/balibase/BBA0020.fasta:data/balibase/BBA0020_aligned.fasta',
            // 'data/balibase/BBA0021.fasta:data/balibase/BBA0021_aligned.fasta',
            // 'data/balibase/BBA0022.fasta:data/balibase/BBA0022_aligned.fasta',
            // // 'data/balibase/BBA0023.fasta:data/balibase/BBA0023_aligned.fasta',
            // 'data/balibase/BBA0024.fasta:data/balibase/BBA0024_aligned.fasta',
            // 'data/balibase/BBA0025.fasta:data/balibase/BBA0025_aligned.fasta'
            // 'data/balibase/BBA0026.fasta:data/balibase/BBA0026_aligned.fasta',
            // 'data/balibase/BBA0027.fasta:data/balibase/BBA0027_aligned.fasta',
            // 'data/balibase/BBA0028.fasta:data/balibase/BBA0028_aligned.fasta',
            // 'data/balibase/BBA0029.fasta:data/balibase/BBA0029_aligned.fasta',
            // 'data/balibase/BBA0030.fasta:data/balibase/BBA0030_aligned.fasta',
            // 'data/balibase/BBA0031.fasta:data/balibase/BBA0031_aligned.fasta',
            // 'data/balibase/BBA0032.fasta:data/balibase/BBA0032_aligned.fasta',
            // 'data/balibase/BBA0033.fasta:data/balibase/BBA0033_aligned.fasta',
            'data/balibase/BBA0034.fasta:data/balibase/BBA0034_aligned.fasta',
            'data/balibase/BBA0035.fasta:data/balibase/BBA0035_aligned.fasta',
            'data/balibase/BBA0036.fasta:data/balibase/BBA0036_aligned.fasta',
            'data/balibase/BBA0037.fasta:data/balibase/BBA0037_aligned.fasta',
            'data/balibase/BBA0038.fasta:data/balibase/BBA0038_aligned.fasta',
            'data/balibase/BBA0039.fasta:data/balibase/BBA0039_aligned.fasta',
            'data/balibase/BBA0040.fasta:data/balibase/BBA0040_aligned.fasta',
            'data/balibase/BBA0041.fasta:data/balibase/BBA0041_aligned.fasta',
            'data/balibase/BBA0042.fasta:data/balibase/BBA0042_aligned.fasta',
            'data/balibase/BBA0043.fasta:data/balibase/BBA0043_aligned.fasta',
            'data/balibase/BBA0044.fasta:data/balibase/BBA0044_aligned.fasta',
            'data/balibase/BBA0045.fasta:data/balibase/BBA0045_aligned.fasta',
            'data/balibase/BBA0046.fasta:data/balibase/BBA0046_aligned.fasta',
            'data/balibase/BBA0047.fasta:data/balibase/BBA0047_aligned.fasta',
            'data/balibase/BBA0048.fasta:data/balibase/BBA0048_aligned.fasta',
            'data/balibase/BBA0049.fasta:data/balibase/BBA0049_aligned.fasta',
            'data/balibase/BBA0050.fasta:data/balibase/BBA0050_aligned.fasta',
        ]
    }
    balibasepremade{
        params.makeEnsemble = false
        params.averagesOnly = true
        params.inputs = [
            'saved-results/balibase/MSA_outputs/BBA0001',
            'saved-results/balibase/MSA_outputs/BBA0002',
            'saved-results/balibase/MSA_outputs/BBA0003',
            'saved-results/balibase/MSA_outputs/BBA0005',
            'saved-results/balibase/MSA_outputs/BBA0006',
            'saved-results/balibase/MSA_outputs/BBA0007',
            'saved-results/balibase/MSA_outputs/BBA0008',
            'saved-results/balibase/MSA_outputs/BBA0009',
            'saved-results/balibase/MSA_outputs/BBA0010',
            'saved-results/balibase/MSA_outputs/BBA0011',
            'saved-results/balibase/MSA_outputs/BBA0012',
            'saved-results/balibase/MSA_outputs/BBA0013',
            'saved-results/balibase/MSA_outputs/BBA0014',
            'saved-results/balibase/MSA_outputs/BBA0015',
            'saved-results/balibase/MSA_outputs/BBA0016',
            'saved-results/balibase/MSA_outputs/BBA0017',
            'saved-results/balibase/MSA_outputs/BBA0018',
            'saved-results/balibase/MSA_outputs/BBA0019',
            'saved-results/balibase/MSA_outputs/BBA0020',
            'saved-results/balibase/MSA_outputs/BBA0021',
            'saved-results/balibase/MSA_outputs/BBA0022',
            'saved-results/balibase/MSA_outputs/BBA0024',
            'saved-results/balibase/MSA_outputs/BBA0025',
            'saved-results/balibase/MSA_outputs/BBA0026',
            'saved-results/balibase/MSA_outputs/BBA0027',
            'saved-results/balibase/MSA_outputs/BBA0028',
            'saved-results/balibase/MSA_outputs/BBA0029',
            'saved-results/balibase/MSA_outputs/BBA0030',
            'saved-results/balibase/MSA_outputs/BBA0031',
            'saved-results/balibase/MSA_outputs/BBA0032',
            'saved-results/balibase/MSA_outputs/BBA0033',
        ]
    }

    /*
     * Runs for testing internal aligner differences based on parameters and modes
     */
    mafft {
        params.runs = [
            'mafft_auto:mafft:mafft --auto',
            'linsi:mafft:linsi',
            'ginsi:mafft:ginsi',
            'einsi:mafft:einsi',
            'fftnsi:mafft:fftnsi',
            'fftnsi_extra_iters:mafft:mafft --retree 2 --maxiterate 1000',
            'fftns:mafft:fftns',
            'fftns_extrafast:mafft:mafft --retree 1 --maxiterate 0',
            'nwnsi:mafft:nwnsi',
            'nwns:mafft:nwns',
            'parttree:mafft:mafft --retree 1 --maxiterate 0 --nofft --parttree',
            'dpparttree:mafft:mafft --retree 1 --maxiterate 0 --nofft --dpparttree',

            'muscle:muscle:-align', //these 4 for 'control' - well its the bestish we can get with everything being relative
            'fsa:fsa:',
            'prank:prank:+F',
            'kalign:kalign:',
        ]
    }
    clustalo {
        params.runs = ['default:clustalo:', 'auto:clustalo:--auto', 'full:clustalo:--full', 'full_iter:clustalo:--full-iter', 'iter10:clustalo:--iter=10', 'guidetree_iter10:clustalo:--max-guidetree-iterations=10', 'hmm_iter10:clustalo:--max-hmm-iterations=10', 'muscle:muscle:-align', 'fsa:fsa:', 'prank:prank:+F', 'kalign:kalign:', 'mafft:mafft:mafft --auto']
    }
    muscle {
        params.runs = [
            'muscle:muscle:-align',
            'super5:muscle:-super5',

            'mafft:mafft:mafft --auto',
            'fsa:fsa:',
            'prank:prank:+F',
            'kalign:kalign:',
        ]
    }
    muscle3 {
        params.runs = ['16_iters:muscle3.8:', 'no_refine:muscle3.8:-maxiters 2', '4_iters:muscle3.8:-maxiters 4', '8_iters:muscle3.8:-maxiters 8', '24_iters:muscle3.8:-maxiters 24', '32_iters:muscle3.8:-maxiters 32', 'muscle:muscle:-align', 'mafft:mafft:mafft --auto', 'fsa:fsa:', 'kalign:kalign:', 'prank:prank:+F']
    }
    prank {
        params.runs = [
            'prank:prank:',
            'prank+F:prank:+F',

            'muscle:muscle:-align',
            'mafft:mafft:mafft --auto',
            'fsa:fsa:',
            'kalign:kalign:',
        ]
    }
    famsa {
        params.runs = [
            'famsa:famsa:',
            'medoid:famsa:--medoidtree',

            'muscle:muscle:-align',
            'mafft:mafft:mafft --auto',
            'fsa:fsa:',
            'kalign:kalign:',
            'prank+F:prank:+F',
        ]
    }
    amap {
        params.runs = [
            'amap:amap:',
            'high_consistency:amap:-c 5',
            '5_iters:amap:-ir 5',
            '50_iters:amap:-ir 50',
            'pretrained_10:amap:-pre 10',
            'allpairs:amap:-pairs',
            'viterbi:amap:-viterbi',
            'maxstep:amap:-maxstep',
            'progressive:amap:-prog',

            'muscle:muscle:-align',
            'mafft:mafft:mafft --auto',
            'fsa:fsa:',
            'kalign:kalign:',
            'prank+F:prank:+F',
        ]
    }
    fsa {
        params.runs = [
            'fsa_unlimited:fsa:',
            'fsa:fsa:--refinement 20',
            'fsa_fast:fsa:--fast',
            'smaller_alphas:fsa:--alphar 1.0 --alphay 1.0',
            'bigger_alphas:fsa:--alphar 1.6 --alphay 1.6',
            'smaller_time:fsa:--time 0.3',
            'bigger_time:fsa:--time 0.5',
            'smallerer_time:fsa:--time 0.2',
            'biggerer_time:fsa:--time 0.6',
            'smaller_beta:fsa:--beta 0.8',
            'bigger_beta:fsa:--beta 1.2',
            'learngap:fsa:--learngap',
            'nolearn:fsa:--nolearn',
            'noregularize:fsa:--noregularize',

            'muscle:muscle:-align',
            'mafft:mafft:mafft --auto',
            'kalign:kalign:',
            'prank+F:prank:+F',
        ]
    }
    bali_phy {
        //Uses to much RAM - unusable
        params.runs = [
            '20_iter:bali-phy:-i 20',
            'bali_phy_10_iter:bali-phy:-i 10',
            '3_iter:bali-phy:-i 3',
            '1_iter:bali-phy:-i 1',
            'no_iter:bali-phy:-i 0',
            'relaxed_subst:bali-phy:-i 10 --subst-rates relaxed',
            'const_indel:bali-phy:-i 10 --indel-rates constant',

            'muscle:muscle:-align',
            'mafft:mafft:mafft --auto',
            'fsa:fsa:',
            'kalign:kalign:',
            'prank+F:prank:+F',
        ]
    }
}
